# HTTP API
PORT=8000
CORS_ORIGIN=http://localhost:5173
AUTH_SECRET=replace-with-a-long-random-secret
RESOLVER_API_KEY=replace-with-a-different-long-random-secret
# Use 120 for a live evaluation demo; production should normally be much longer.
CHALLENGE_WINDOW_SECONDS=1800
# DB_FILE=./server/data/verity-db.json

# Vercel-only deployment: add Neon from Vercel Marketplace. The integration
# injects DATABASE_URL automatically; POSTGRES_URL is accepted as a fallback.
# DATABASE_URL=postgresql://...

# Optional: used by a deployment relay, never expose these in the browser.
# GENLAYER_NETWORK=testnetBradbury
# GENLAYER_RPC_URL=
# GENLAYER_RESOLVER_CONTRACT=
# GENLAYER_RESOLUTION_TX=
# EVM_RPC_URL=
# RELAYER_PRIVATE_KEY=

# `npm run genlayer:deploy-markets` deploys one PredictionMarket per resolver in
# genlayer/deployments/bradbury-v2.json. It spends real Bradbury GEN, so it refuses
# to run without this flag. The key is read from .secrets/genlayer-relayer.json,
# which is git-ignored and excluded from every release archive.
# CONFIRM_BRADBURY_DEPLOY=YES
# RELAYER_KEY_FILE=./.secrets/genlayer-relayer.json
# PredictionMarket refuses a zero dispute resolver, and `genlayer:deploy-markets`
# binds to resolvers that already exist rather than deploying them, so it needs to
# be told which adjudicator its markets appeal to. It must be bound to the same
# market ID, spec hash, sources hash and observation time as the resolver it
# adjudicates. `npm run genlayer:live-demo` deploys its own and needs none of this.
# DISPUTE_RESOLVER=0x...

# resolver:publish sends the finalized transaction proof; the API reads the outcome itself.
# MARKET_ID=
